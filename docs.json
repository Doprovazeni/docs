        ]
      },
      {
        "group": "Právní informace",
        "pages": [
          "gdpr",
          "kontakt"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "facebook": "https://www.facebook.com/profile.php?id=61588246142192",
      "instagram": "https://www.instagram.com/doprovazeni",
      "github": "https://github.com/Doprovazeni"
