{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Doprovázení",
  "theme": "mint",
  "logo": {
    "light": "/images/doprovazeni__logo__black.svg",
    "dark": "/images/doprovazeni__logo__white.svg"
