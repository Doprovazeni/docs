        ]
      },
      {
        "group": "Vzdělávání",
        "pages": [
          "vzdelavani/online-kurzy",
          "vzdelavani/prezencni-kurzy",
          "vzdelavani/lektori"
        ]
      },
      {
        "group": "Tým a region",
        "pages": [
          "tym",
