  "search": {
    "prompt": "Hledejte nebo se zeptejte ..."
  },
  "markdown": {
    "schema": true
  },
  "styling": {
    "eyebrows": "section",
    "latex": true
  },
  "icons": {
    "library": "fontawesome"
